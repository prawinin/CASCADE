# CASCADE — Environment Configuration
# Copy this file to .env and run: python compose_up.py
# The script auto-generates a secure FLASK_SECRET_KEY on first run.

# ── Server ────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_SECRET_KEY=replace-with-a-long-random-secret
HOST=0.0.0.0
# HOST_PORT: the port exposed on your machine (default 7860)
# HOST_PORT=7860
MODEL_DEVICE=cpu

# ── Registration ──────────────────────────────────────────────────────────────
# Set to 1 to allow new users to sign up. Flip to 0 after your accounts are
# created to close public registration.
REGISTRATION_ENABLED=1

# ── Ollama (optional local LLM assistant) ────────────────────────────────────
# Install Ollama from https://ollama.com and pull a model, then set:
#   OLLAMA_ENABLED=1
#   OLLAMA_API_URL=http://host.docker.internal:11434
#   OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_ENABLED=0
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=15

# ── GNINA docking (optional) ─────────────────────────────────────────────────
# To enable, place the gnina binary in the project root and set:
#   GNINA_ENABLED=1
#   GNINA_PATH=./gnina
GNINA_ENABLED=0

# ── Molecular processing limits ───────────────────────────────────────────────
MOLECULE_SIZE_LIMIT=200
SMILES_LENGTH_LIMIT=2000

# ── Performance ───────────────────────────────────────────────────────────────
WEB_CONCURRENCY=1
GUNICORN_THREADS=2

# ── Data paths (only needed when storing data outside the repo folder) ────────
# CASCADE_DATA_HOST_PATH=/path/to/your/data
# CASCADE_MODELS_HOST_PATH=/path/to/your/models

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

