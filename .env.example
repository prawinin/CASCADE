# KineticSketch AI - Environment Configuration
# Copy this file to .env and adjust values for your environment

# Flask/Taipy Server
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_SECRET_KEY=replace-with-a-long-random-secret
HOST=0.0.0.0
# Leave PORT unset for local auto-selection. Hosting providers may inject it.
# PORT=7860
# Docker Compose host port; compose_up.py selects one when unset.
# HOST_PORT=7860
MODEL_DEVICE=cpu
MODEL_SHA256=f9d35a9adccf8756db869ae7dba94c04d7025470efbd6a2550a232bca8b8c030

# PyMOL Integration
PYMOL_SERVER_HOST=localhost
PYMOL_SERVER_PORT=9123
PYMOL_LISTEN_TIMEOUT=5
PYMOL_ENABLED=0

# Optional local docking integration. Leave disabled on deployments that do not
# install the GNINA executable.
GNINA_ENABLED=0

# Ollama AI Integration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=15
OLLAMA_ENABLED=0

# Service requirements. Set REQUIRE_REDIS=0 only for a reduced single-process demo.
REQUIRE_REDIS=1
REQUIRE_MODEL=1
REQUIRE_DRUG_DATA=1

# Trust only the known reverse-proxy hop in Docker/production. Keep 0 when the
# application is reached directly.
TRUST_PROXY_HOPS=0
# Keep framing denied by default. For the Hugging Face embedded deployment use:
# EMBEDDED_MODE=1
# FRAME_ANCESTORS=https://huggingface.co https://prawin.app https://www.prawin.app
EMBEDDED_MODE=0
FRAME_ANCESTORS='none'
PASSWORD_HASH_ITERATIONS=600000
# Disabled by default; enable only with an appropriate consent/privacy process.
ACTION_LOGGING_ENABLED=0
# Disable public sign-up after creating the accounts you need. Docker Compose
# defaults this to 0 even when this line is omitted.
REGISTRATION_ENABLED=0

# Molecular Processing
MOLECULE_SIZE_LIMIT=200
SMILES_LENGTH_LIMIT=2000
PDB_CACHE_TTL=3600
JOB_RETENTION_HOURS=72

# Portable storage overrides. Relative defaults are derived from the source
# tree, so these are only needed when using external/persistent volumes.
# KINETICSKETCH_DATA_DIR=/var/lib/kineticsketch/data
# KINETICSKETCH_STATE_DIR=/var/lib/kineticsketch/data
# KINETICSKETCH_JOBS_DIR=/var/lib/kineticsketch/jobs
# KINETICSKETCH_CACHE_DIR=/var/cache/kineticsketch
# MODEL_WEIGHTS_PATH=/opt/kineticsketch/app/models/mdrepo_predictor.pt
# DRUG_DATABASE_PATH=/var/lib/kineticsketch/data/drug_database.sqlite
# DRUG_FINGERPRINT_PATH=/var/lib/kineticsketch/data/drug_fingerprints.npz

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/tmp/kinetic_sketch.log

# Development (set to 0 in production)
ENABLE_DEBUG_CONSOLE=0
ENABLE_CORS=0
