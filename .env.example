# KineticSketch AI - Environment Configuration
# Copy this file to .env and adjust values for your environment

# Flask/Taipy Server
FLASK_ENV=production
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-me-in-production

# PyMOL Integration
PYMOL_SERVER_HOST=localhost
PYMOL_SERVER_PORT=9123
PYMOL_LISTEN_TIMEOUT=5
PYMOL_ENABLED=1

# Ollama AI Integration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=15
OLLAMA_ENABLED=1

# Molecular Processing
MOLECULE_SIZE_LIMIT=200
SMILES_LENGTH_LIMIT=2000
PDB_CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/tmp/kinetic_sketch.log

# Development (set to 0 in production)
ENABLE_DEBUG_CONSOLE=0
ENABLE_CORS=0
